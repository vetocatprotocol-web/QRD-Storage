{
  "name": "qrd-storage",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@8.12.0",
  "type": "module",
  "scripts": {
    "setup": "pnpm install",
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "start:api": "pnpm --filter @qrd/api dev"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@types/node": "^20.11.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.0.0",
    "turbo": "^1.12.3",
    "typescript": "^5.5.4"
  }
}
