{
  "name": "@qrd/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "node --loader ts-node/esm.mjs src/main.ts",
    "build": "tsc -b tsconfig.json",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^10.2.1",
    "@nestjs/core": "^10.2.1",
    "@nestjs/platform-fastify": "^10.2.1",
    "@nestjs/config": "^3.1.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^4.24.0",
    "reflect-metadata": "^0.1.13",
    "zod": "^4.4.3",
    "argon2": "^0.44.0",
    "jsonwebtoken": "^9.0.2",
    "@prisma/client": "^5.13.0",
    "@fastify/cookie": "^8.2.0",
    "@fastify/helmet": "^11.0.0",
    "@fastify/rate-limit": "^7.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/jsonwebtoken": "^9.0.3",
    "prisma": "^5.13.0",
    "ts-node-dev": "^2.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.5.4"
  }
}
